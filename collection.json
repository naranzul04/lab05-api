    {
      "name": "TC-05: Урьдач нөхцөл дутуу үед ERROR_PREREQUISITES ба missing массив буцах",
      "item": [
        {
          "name": "Setup - Зөвхөн CS102 үзсэн оюутан S1003 үүсгэх",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS102\"]}" },
            "url": "{{baseUrl}}/students/S1003"
          }
        },
        {
          "name": "Setup - CS102 ба CS210 урьдач шаардах SE410 хичээл үүсгэх",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"prerequisites\":[\"CS102\",\"CS210\"]}" },
            "url": "{{baseUrl}}/courses/SE410"
          }
        },
        {
          "name": "Test - Дутуу урьдач нөхцөлтэй бүртгэл",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP статус 200 буцаах ёстой', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('ERROR_PREREQUISITES ба дутуу хичээл CS210 буцах ёстой', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.result).to.eql('ERROR_PREREQUISITES');",
                  "    pm.expect(data.missing).to.eql(['CS210']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"studentID\":\"S1003\",\"courseID\":\"SE410\"}" },
            "url": "{{baseUrl}}/registrations"
          }
        }
      ]
