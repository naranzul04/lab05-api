    {
      "name": "TC-11: Даалгавар 5 - Нийтийн API (JSONPlaceholder Users)",
      "item": [
        {
          "name": "Test - GET /users (статус 200, массив, эхний хэрэглэгч)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP статус 200 буцаах ёстой', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Хариу нь хоосон биш массив байх ёстой', function () {",
                  "    const users = pm.response.json();",
                  "    pm.expect(users).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test('Эхний хэрэглэгчийн нэр Leanne Graham байх ёстой', function () {",
                  "    const users = pm.response.json();",
                  "    pm.expect(users[0].name).to.eql('Leanne Graham');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "https://jsonplaceholder.typicode.com/users"
          }
        }
