{
  "info": {
    "name": "Lab 05 - Student Course Registration API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "TC-01: Идэвхтэй оюутан урьдач нөхцөл хангасан үед амжилттай бүртгүүлэх",
      "item": [
        {
          "name": "Setup - Идэвхтэй оюутан S1001 үүсгэх",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS102\",\"MA101\"]}" },
            "url": "{{baseUrl}}/students/S1001"
          }
        },
        {
          "name": "Setup - Урьдач нөхцөлтэй SE305 хичээл үүсгэх",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"prerequisites\":[\"CS102\"]}" },
            "url": "{{baseUrl}}/courses/SE305"
          }
        },
        {
          "name": "Test - POST /registrations амжилттай бүртгэл (201 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP статус 201 буцаах ёстой', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Хариу result нь OK ба registrationID тоо байх ёстой', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.result).to.eql('OK');",
                  "    pm.expect(data.registrationID).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"studentID\":\"S1001\",\"courseID\":\"SE305\"}" },
            "url": "{{baseUrl}}/registrations"
          }
        }
      ]
    },
